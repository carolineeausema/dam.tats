# Copy this to .env.local and fill in real values. .env.local is gitignored.

# Resend API key, used by app/api/booking/route.ts to email new booking/
# consultation submissions to Dylan. Get one free at https://resend.com
# (sign up with the same address as SITE.email in lib/site-config.ts —
# without a verified custom domain, Resend's shared sending address can
# only deliver to the email the account was created with).
RESEND_API_KEY=
